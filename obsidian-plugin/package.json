{
  "name": "obsidian-relay",
  "version": "0.1.0",
  "description": "Obsidian sidebar companion for the obsidian-relay two-vault workflow.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "obsidian-plugin"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.6.6",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5"
  }
}
